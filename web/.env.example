# ===========================================
# Boki Web — Environment Variables Template
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_SCHEDULE_URL=http://localhost:3001

# --- Direct Google OAuth 2.0 (Google Cloud Console) ---
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/login, https://boki.nhatcuong.io.vn/login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Facebook Login (Meta for Developers) ---
# Create at: https://developers.facebook.com/apps
# Valid OAuth Redirect URIs: http://localhost:3000/login, https://boki.nhatcuong.io.vn/login
NEXT_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
