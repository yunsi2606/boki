# Backend REST API Base URL
# Local: http://localhost:8080/api
# Production (Cloudflare Tunnel): https://api-boki.nhatcuong.io.vn/api
# Production Backup (Render): https://boki-api.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Main Boki Store Web URL (để liên kết chuyển sang sàn sách chính)
# Local: http://localhost:3000
# Production: https://boki.nhatcuong.io.vn
NEXT_PUBLIC_STORE_URL=http://localhost:3000
